# NIVO API environment — copy to .env (never commit real secrets)
NODE_ENV=development
HOST=0.0.0.0
PORT=4000
LOG_LEVEL=info

# Public web app origin(s); CORS_ORIGINS is comma separated
APP_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# Postgres (drizzle-kit uses this for db:generate / db:migrate)
DATABASE_URL=postgres://nivo:nivo@localhost:5433/nivo

# >= 32 chars. Used to derive the AES-256-GCM key for identity data + TOTP secrets.
IDENTITY_ENCRYPTION_KEY=change-me-to-a-long-random-string-of-32+chars

# Stripe (list price stays EUR 149.00). Adaptive Pricing needs a settlement currency —
# leave STRIPE_CHARGE_* unset to auto-convert when the account settles in NZD/USD/etc.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# STRIPE_CHARGE_CURRENCY=nzd
# STRIPE_CHARGE_AMOUNT_CENTS=27000


# Argon2id tuning (OWASP minimum: 19 MiB, t=2, p=1)
ARGON2_MEMORY_KIB=19456
ARGON2_TIME_COST=2

# Rate limits (per IP, per minute)
RATE_LIMIT_MAX=120
AUTH_RATE_LIMIT_MAX=10

# Set true when running behind a reverse proxy / load balancer
TRUST_PROXY=false

# Seed navigable test personas on startup (auto = on in development)
SEED_DEV_DATA=auto

# Email — EMAIL_PROVIDER selects the transport (memory | resend; add more in createEmailProvider)
EMAIL_PROVIDER=resend
EMAIL_API_KEY=
# Resend test sender until your domain is verified
EMAIL_FROM=NIVO <onboarding@resend.dev>

# Google Sign-In (optional). GIS ID-token flow needs Authorized JavaScript origins only:
#   http://localhost:5173
#   http://127.0.0.1:5173
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Legacy redirect flow (optional)
GOOGLE_REDIRECT_URI=http://localhost:4000/v1/auth/google/callback
